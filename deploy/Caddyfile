{
    servers {
        protocols h1 h2
    }
}

{$PUBLIC_HOST} {
    encode zstd gzip
    header Strict-Transport-Security "max-age=31536000"
    reverse_proxy web:80
}

# Canonical destination for plain HTTP, including requests to the VM IP.
:80 {
    redir https://{$PUBLIC_HOST}{uri} permanent
}
